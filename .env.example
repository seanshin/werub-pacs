# ===== OpenPACS Environment Variables =====
# Copy this file to .env and fill in actual values
# NEVER commit .env to git
# Secrets (CHANGE_ME): generate with `openssl rand -base64 32`

# ===== Institution (per-install) =====
INSTITUTION_NAME=WeRU.B PACS         # display name, DICOM InstitutionName
INSTITUTION_ID=WERUB                 # short code (HL7 facility, provenance)
TIMEZONE=Asia/Seoul                  # TAT/SLA/report timestamps
BASE_URL=https://pacs.example.org    # public origin of this install (TLS domain)

# PostgreSQL
POSTGRES_USER=openpacs
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openpacs

# Redis
REDIS_PASSWORD=CHANGE_ME

# Orthanc
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=CHANGE_ME
# Our DICOM AE Title — must match Orthanc's config and how modalities/PACS
# address us (C-MOVE TargetAet, MWL scheduled station).
ORTHANC_AET=OPENPACS
# Standalone MWL SCP listener AE (separate process). Defaults to OPENPACS-MWL.
MWL_AE_TITLE=OPENPACS-MWL

# FastAPI
DATABASE_URL=postgresql+asyncpg://openpacs:CHANGE_ME@127.0.0.1:5432/openpacs
SECRET_KEY=CHANGE_ME_min_32_chars_random
ORTHANC_URL=http://127.0.0.1:8042

# HospitalRun / Hospital common SSO. Empty HOSPITALRUN_AUTH_SECRET = SSO off
# (standalone login only). HIS_JWKS_URL enables RS256 common-SSO.
HOSPITALRUN_AUTH_SECRET=
HIS_JWKS_URL=                        # e.g. https://his.example.org/api/v1/sign-integration/jwks
HIS_JWT_AUDIENCE=                    # e.g. pacs (empty = skip aud check, dev only)
HIS_JWT_ISSUER=                      # e.g. hospitalrun
HOSPITALRUN_DB_URL=                  # optional read-only order sync; empty = disabled

# WeRU.B AI Server (optional — empty keys disable AI calls).
# MUST be an on-premises host: inference payloads are clinical pixel data.
# Extra allowed hosts for per-model endpoint_url (comma-separated; the
# AI_SERVER_URL host and localhost are always allowed — anything else is
# rejected at model registration and at inference time).
AI_SERVER_URL=https://ai.example.org/ollama
AI_API_KEY=CHANGE_ME
AI_MEDICAL_KEY=CHANGE_ME
AI_ENDPOINT_ALLOWLIST=

# Predictive prefetch — must point at this install's public origin (nginx cache).
PREFETCH_WARM_BASE_URL=https://pacs.example.org

# External e-signature (sign service) — default OFF. Enable when the service exists.
SIGN_SERVICE_ENABLED=false
SIGN_SERVICE_URL=http://127.0.0.1:4100/v1
SIGN_SERVICE_API_KEY=                # x-api-key (PACS_API_KEY)
SIGN_PORTAL_BASE_URL=https://sign.example.org

# Patient result export — default OFF (PHI). Set a dedicated 64-char secret to enable.
PATIENT_EXPORT_ENABLED=false
PATIENT_EXPORT_SECRET=               # openssl rand -hex 32

# Patient result-VIEW portal (환자 본인 웹 열람, staff-issued token) — default OFF (PHI read).
PATIENT_VIEW_ENABLED=false

# IHE ATNA audit (cross-institution). Default OFF until an Audit Repository exists.
# PRODUCTION: use tls (port 6514) — udp/tcp send PatientID-bearing audit records
# in cleartext, acceptable only on an isolated audit LAN or loopback.
ATNA_ENABLED=false
ATNA_HOST=127.0.0.1
ATNA_PORT=514                        # 6514 for tls
ATNA_TRANSPORT=udp                   # udp | tcp | tls (production: tls)

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ===== Service Ports / Bindings (docker-compose.yml) =====
# Only nginx (80/443) is public. DB/Redis/Orthanc-HTTP bind to 127.0.0.1 (debug).
POSTGRES_PORT=5432
REDIS_PORT=6379
ORTHANC_HTTP_PORT=8042
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090           # only with --profile monitoring
GRAFANA_PORT=3000              # only with --profile monitoring

# DICOM / HL7 listener bind interface. 127.0.0.1 = closed (safe default).
# To receive C-STORE from modalities / HL7 from HIS, set 0.0.0.0 (or the LAN IP)
# and firewall the device network. See docs/cstore-pilot-readiness.md.
DICOM_BIND=127.0.0.1
ORTHANC_DICOM_PORT=4242        # Orthanc C-STORE/C-FIND/C-MOVE
MWL_PORT=4243                  # Modality Worklist SCP
HL7_PORT=2575                  # HL7 v2 MLLP listener
# HL7 sender gates (optional hardening, empty = allow all — MLLP has no auth,
# so narrow who can create/cancel worklist orders once the sender is known):
#   HL7_ALLOWED_PEERS       comma-separated source IPs/CIDRs allowed to connect
#   HL7_ALLOWED_FACILITIES  comma-separated MSH-3(app)/MSH-4(facility) values
HL7_ALLOWED_PEERS=
HL7_ALLOWED_FACILITIES=

# DICOM TLS (optional hardening) — encrypt DIMSE on the modality LAN.
# When true, port 4242 becomes TLS-ONLY (non-TLS modalities can't connect), so
# enable only if every modality supports DICOM TLS. Generate certs first:
#   scripts/install/gen-dicom-tls.sh <orthanc-host-or-ip>   → docker/orthanc/tls/
# ORTHANC_DICOM_TLS_MUTUAL=true additionally requires each modality to present a
# client cert signed by the internal CA (scripts/install/gen-dicom-tls.sh --client <name>).
ORTHANC_DICOM_TLS_ENABLED=false
ORTHANC_DICOM_TLS_MUTUAL=false

# Celery worker concurrency
CELERY_CONCURRENCY=2

# nginx → Orthanc upstream Basic-auth header. MUST equal base64("user:pass"):
#   ORTHANC_BASIC_AUTH=$(printf '%s:%s' "$ORTHANC_USERNAME" "$ORTHANC_PASSWORD" | base64)
# (install.sh computes this automatically.)
ORTHANC_BASIC_AUTH=CHANGE_ME
