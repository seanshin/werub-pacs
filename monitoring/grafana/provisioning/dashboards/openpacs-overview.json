{
  "dashboard": {
    "id": null,
    "uid": "openpacs-overview",
    "title": "OpenPACS Overview",
    "tags": ["openpacs"],
    "timezone": "Asia/Seoul",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "API Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [{ "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{handler}}" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 2,
        "title": "API Response Time (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "id": 3,
        "title": "CPU Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
        "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}] } } }
      },
      {
        "id": 4,
        "title": "Memory Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
        "targets": [{ "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "Memory" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}] } } }
      },
      {
        "id": 5,
        "title": "Disk Usage (%)",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
        "targets": [{ "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "Disk" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}] } } }
      },
      {
        "id": 6,
        "title": "Orthanc Studies Count",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
        "targets": [{ "expr": "orthanc_count_studies", "legendFormat": "Studies" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
      },
      {
        "id": 7,
        "title": "HTTP Error Rate (5xx)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
        "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx errors/s" }],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } }
      },
      {
        "id": 8,
        "title": "Network I/O",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
        "targets": [
          { "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "RX {{device}}" },
          { "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "TX {{device}}" }
        ],
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "fieldConfig": { "defaults": { "unit": "Bps" } }
      }
    ]
  }
}
