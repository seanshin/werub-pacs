diff --git a/extensions/dicom-microscopy/src/components/MicroscopyPanel/MicroscopyPanel.tsx b/extensions/dicom-microscopy/src/components/MicroscopyPanel/MicroscopyPanel.tsx
index ecb7949..17b0546 100644
--- a/extensions/dicom-microscopy/src/components/MicroscopyPanel/MicroscopyPanel.tsx
+++ b/extensions/dicom-microscopy/src/components/MicroscopyPanel/MicroscopyPanel.tsx
@@ -226,6 +226,103 @@ function MicroscopyPanel(props: IMicroscopyPanelProps) {
     }
   };
 
+  /**
+   * WeRU.B(G1): 드로잉한 ROI를 표준 DICOM ANN(Microscopy Bulk Simple Annotations, Sup222)으로 저장.
+   * 계산병리 AI 출력과 동일 형식 — 병리의 수기 마킹을 SCOORD3D(슬라이드 좌표)로 백엔드에 전송.
+   * 백엔드 POST /pacs-api/api/v1/pathology/{study}/annotations → highdicom ANN → Orthanc.
+   */
+  const [savingAnn, setSavingAnn] = useState(false);
+  // 저장 성공한 ROI uid — 반복 클릭이 같은 ROI를 새 ANN 시리즈로 중복 생성하지 않게
+  const savedRoiUids = React.useRef<Set<string>>(new Set());
+  const saveAsAnn = async () => {
+    const { uiNotificationService } = servicesManager.services;
+    const all = microscopyService.getAnnotationsForStudy(studyInstanceUID) || [];
+    const annotations = all.filter(roi => !savedRoiUids.current.has(roi.uid));
+    if (!annotations.length || savingAnn) {
+      uiNotificationService?.show({
+        title: '주석 저장',
+        message: all.length
+          ? '모든 주석이 이미 저장되었습니다. 새로 그린 주석만 저장됩니다.'
+          : '저장할 주석이 없습니다. 먼저 폴리곤/포인트를 그리세요.',
+        type: 'info',
+      });
+      return;
+    }
+    // 각 ROI = 하나의 주석 그룹(라벨 + geometry). scoord3d는 슬라이드 3D 좌표.
+    // 다중 슬라이드 study 대비: ROI가 그려진 시리즈별로 묶어 series_uid와 함께 전송
+    // (백엔드가 해당 SM 시리즈에 주석을 결합 — 임의 첫 슬라이드 결합 방지).
+    const bySeries = new Map();
+    for (const roi of annotations) {
+      const s = roi.roiGraphic && roi.roiGraphic.scoord3d;
+      if (!s || !s.graphicData || !s.graphicData.length) {
+        continue;
+      }
+      const graphicType = String(s.graphicType || 'POLYGON').toUpperCase();
+      // dmv Point.graphicData는 flat [x,y,z] — 나머지 타입은 [[x,y,z],...]
+      const points = graphicType === 'POINT' ? [s.graphicData] : s.graphicData;
+      const group = {
+        label: roi.label || roi.getDetailedLabel?.() || 'annotation',
+        graphic_type: graphicType,
+        algorithm_type: 'MANUAL',
+        coordinates: [points], // ROI 1개 = 주석 1개(점 배열의 리스트)
+      };
+      const seriesKey = roi.seriesInstanceUID || '';
+      if (!bySeries.has(seriesKey)) {
+        bySeries.set(seriesKey, []);
+      }
+      bySeries.get(seriesKey).push({ group, uid: roi.uid });
+    }
+    const totalGroups = [...bySeries.values()].reduce((n, g) => n + g.length, 0);
+    if (!totalGroups) {
+      uiNotificationService?.show({
+        title: '주석 저장', message: '유효한 좌표를 가진 주석이 없습니다.', type: 'warning',
+      });
+      return;
+    }
+    setSavingAnn(true);
+    try {
+      const token = localStorage.getItem('pacs_token');
+      let saved = 0;
+      for (const [seriesUID, items] of bySeries) {
+        const res = await fetch(
+          `${window.location.origin}/pacs-api/api/v1/pathology/${studyInstanceUID}/annotations`,
+          {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+              ...(token ? { Authorization: `Bearer ${token}` } : {}),
+            },
+            body: JSON.stringify({
+              coordinate_type: '3D',
+              groups: items.map(it => it.group),
+              ...(seriesUID ? { series_uid: seriesUID } : {}),
+            }),
+          }
+        );
+        if (!res.ok) {
+          const txt = await res.text().catch(() => '');
+          throw new Error(`${res.status} ${txt.slice(0, 200)}`);
+        }
+        const out = await res.json();
+        saved += out.groups || 0;
+        items.forEach(it => it.uid && savedRoiUids.current.add(it.uid)); // 시리즈 단위 성공 시에만 마킹
+      }
+      uiNotificationService?.show({
+        title: 'DICOM 주석 저장됨',
+        message: `${saved}개 주석을 표준 ANN으로 저장했습니다. 스터디를 다시 열면 표시됩니다.`,
+        type: 'success',
+      });
+    } catch (error: any) {
+      uiNotificationService?.show({
+        title: '주석 저장 실패',
+        message: error?.message || String(error),
+        type: 'error',
+      });
+    } finally {
+      setSavingAnn(false);
+    }
+  };
+
   /**
    * On clicking "Reject annotations" button
    */
@@ -358,6 +455,17 @@ function MicroscopyPanel(props: IMicroscopyPanelProps) {
           ))}
         </div>
       </div>
+      <div className="flex justify-center p-2">
+        <button
+          type="button"
+          disabled={savingAnn}
+          onClick={saveAsAnn}
+          data-cy="save-microscopy-ann"
+          className="text-primary-light border-primary-light hover:bg-primary-light hover:text-black rounded border px-3 py-2 text-base disabled:opacity-50"
+        >
+          {savingAnn ? '저장 중…' : 'DICOM 주석 저장(ANN)'}
+        </button>
+      </div>
     </>
   );
 }
